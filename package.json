{
  "name": "realtime-kit",
  "version": "0.1.0",
  "description": "Lightweight, secure WebSocket toolkit: pub/sub + request/response for Node, Express, NestJS, React, Vue, Angular, Next.js & Nuxt.",
  "keywords": [
    "websocket",
    "realtime",
    "pubsub",
    "ws",
    "express",
    "nestjs",
    "react",
    "vue",
    "angular",
    "nextjs",
    "nuxt"
  ],
  "license": "MIT",
  "author": "Mohit Singh",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/mohit77u/realtime-kit.git"
  },
  "homepage": "https://github.com/mohit77u/realtime-kit#readme",
  "bugs": {
    "url": "https://github.com/mohit77u/realtime-kit/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "exports": {
    "./server": {
      "import": {
        "types": "./dist/server/index.d.ts",
        "default": "./dist/server/index.js"
      },
      "require": {
        "types": "./dist/server/index.d.cts",
        "default": "./dist/server/index.cjs"
      }
    },
    "./client": {
      "import": {
        "types": "./dist/client/index.d.ts",
        "default": "./dist/client/index.js"
      },
      "require": {
        "types": "./dist/client/index.d.cts",
        "default": "./dist/client/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react/index.d.ts",
        "default": "./dist/react/index.js"
      },
      "require": {
        "types": "./dist/react/index.d.cts",
        "default": "./dist/react/index.cjs"
      }
    },
    "./vue": {
      "import": {
        "types": "./dist/vue/index.d.ts",
        "default": "./dist/vue/index.js"
      },
      "require": {
        "types": "./dist/vue/index.d.cts",
        "default": "./dist/vue/index.cjs"
      }
    },
    "./angular": {
      "import": {
        "types": "./dist/angular/index.d.ts",
        "default": "./dist/angular/index.js"
      },
      "require": {
        "types": "./dist/angular/index.d.cts",
        "default": "./dist/angular/index.cjs"
      }
    },
    "./nest": {
      "import": {
        "types": "./dist/nest/index.d.ts",
        "default": "./dist/nest/index.js"
      },
      "require": {
        "types": "./dist/nest/index.d.cts",
        "default": "./dist/nest/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "peerDependencies": {
    "@nestjs/common": ">=9",
    "@nestjs/core": ">=9",
    "react": ">=17",
    "reflect-metadata": ">=0.1.13",
    "rxjs": ">=7",
    "vue": ">=3.3"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "rxjs": {
      "optional": true
    },
    "@nestjs/common": {
      "optional": true
    },
    "@nestjs/core": {
      "optional": true
    },
    "reflect-metadata": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nestjs/common": "^10.4.22",
    "@nestjs/core": "^10.4.22",
    "@nestjs/platform-express": "^10.4.22",
    "@nestjs/testing": "^10.4.22",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/ws": "^8.5.12",
    "react": "^18.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "vue": "^3.5.44"
  },
  "typesVersions": {
    "*": {
      "server": [
        "dist/server/index.d.ts"
      ],
      "client": [
        "dist/client/index.d.ts"
      ],
      "react": [
        "dist/react/index.d.ts"
      ],
      "vue": [
        "dist/vue/index.d.ts"
      ],
      "angular": [
        "dist/angular/index.d.ts"
      ],
      "nest": [
        "dist/nest/index.d.ts"
      ]
    }
  }
}
